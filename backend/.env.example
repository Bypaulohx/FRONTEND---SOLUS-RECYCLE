# Copie para .env e ajuste conforme o ambiente
PORT=8006
DB_URL=sqlite:///./data/solus.db
JWT_SECRET=solus-recycle-secret-local-change-me-please-123456
JWT_EXPIRATION=3600
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5173","http://127.0.0.1:5173","http://localhost:5176","http://127.0.0.1:5176"]

# Integrações externas (opcionais em desenvolvimento local)
CEPABERTO_TOKEN=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=fotos-perfil
BREVO_API_KEY=

# Login social (OAuth2). Vazio = modo demonstração com JWT local.
FRONTEND_URL=http://localhost:5173
SOCIAL_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
SEED_DEMO_DATA=true
